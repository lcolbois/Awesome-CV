{
    // Essential: Tells the PDF viewer to look in the sibling 'builds' folder
    "latex-workshop.latex.outDir": "../builds",

    // --- TOOLS ---
    "latex-workshop.latex.tools": [
        {
            "name": "Make (Build)",
            "command": "make",
            "args": [
                "-C",
                "%WORKSPACE_FOLDER%",
                "builds/%DOCFILE%.pdf"
            ],
            "env": {}
        },
    ],

    // --- RECIPES ---
    "latex-workshop.latex.recipes": [
        {
            "name": "Build (Make)",
            "tools": [
                "Make (Build)"
            ]
        }
    ],

    // Default recipe (Cmd/Ctrl + Alt + B)
    "latex-workshop.latex.recipe.default": "Build (Make)",
// 1. Tell VS Code: "Don't use latexmk or glob patterns. Run a custom command."
    "latex-workshop.latex.clean.method": "command",

    // 2. The command is 'make'
    "latex-workshop.latex.clean.command": "make",

    // 3. The arguments: Change directory to root, then run the rule
    "latex-workshop.latex.clean.args": [
        "-C",
        "%WORKSPACE_FOLDER%",
        "cleantemp"
    ]

}