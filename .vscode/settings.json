{
    // Tells the PDF viewer where to find the built PDF
    "latex-workshop.latex.outDir": "%DIR%/build",

    // --- TOOLS ---
    "latex-workshop.latex.tools": [
        {
            "name": "Make (app)",
            "command": "bash",
            "args": [
                "%WORKSPACE_FOLDER%/.vscode/build.sh",
                "%DIR%",
                "%WORKSPACE_FOLDER%"
            ],
            "env": {}
        }
    ],

    // --- RECIPES ---
    "latex-workshop.latex.recipes": [
        {
            "name": "Build (Make)",
            "tools": ["Make (app)"]
        }
    ],

    // Default recipe (Ctrl+Alt+B)
    "latex-workshop.latex.recipe.default": "Build (Make)",

    // Clean via make cleantemp
    "latex-workshop.latex.clean.method": "command",
    "latex-workshop.latex.clean.command": "make",
    "latex-workshop.latex.clean.args": [
        "-C",
        "%WORKSPACE_FOLDER%",
        "cleantemp"
    ]
}
